// Test file for for loops in ZZ

// Basic for loop: @(var#start..end)
print("Counting 1 to 5:")
@(i#1..5)
  print(i)
;

print("")

// For loop with expressions
i#start = 2
i#end = 6
print("Counting 2 to 6:")
@(j#start..end)
  print(j)
;

print("")

// Comparing for loop vs while loop
print("For loop (1 to 3):")
@(x#1..3)
  print(x)
;

print("While loop (1 to 3):")
i~count = 1
@(count <= 3)
  print(count)
  count = count + 1
;

print("")

// For loop with break
print("For loop with break at 3:")
@(n#1..5)
  ?(n == 3)
    >!
  ;
  print(n)
;

print("")

// Nested for loops
print("Multiplication table (1-3):")
@(a#1..3)
  @(b#1..3)
    i#product = a * b
    print(s"{a} x {b} = {product}")
  ;
;

// Reverse for loop
print("Running down")
@(a#5..1)
  print(a)
;
print("Done!")
