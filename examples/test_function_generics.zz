// Test generic functions

// Generic function: first<T> returns first element of array
<T> T Z first(T[]#arr)
  arr[0]
;

// Test with int array
i[]#nums = [10, 20, 30]
i#firstNum = first(nums)
print(s"First number: {firstNum}")

// Test with string array
s[]#words = ["hello", "world"]
s#firstWord = first(words)
print(s"First word: {firstWord}")

print("Function generics test passed!")
