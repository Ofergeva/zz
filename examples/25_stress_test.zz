// === 15. Complex Function Signatures ===
print("")
print("=== Complex Function Signatures ===")

Vector2 Z createVector(f#x f#y)
  Vector2(x, y)
;

// Simplified - creating array inline rather than using local complex array var
Vector2[] Z getVectors(i#count)
  [Vector2(0.0, 0.0), Vector2(1.0, 2.0), Vector2(2.0, 4.0), Vector2(3.0, 6.0), Vector2(4.0, 8.0)]
;

Vector2#newVec = createVector(100.0, 200.0)
print(s"Created vector: ({newVec.x}, {newVec.y})")

Vector2[]#manyVecs = getVectors(5)
print(s"Generated {manyVecs.len()} vectors")

// === 16. Deep Pattern Matching ===
print("")
print("=== Deep Pattern Matching ===")

S Result
  b#success
  s#message
  i#code
;

s Z handleResult(Result#r)
  ??(r)
    | Result(true, m, 0) => s"Success: {m}"
    | Result(true, m, c) & c > 0 => s"Success with code {c}: {m}"
    | Result(false, m, 404) => s"Not found: {m}"
    | Result(false, m, 500) => s"Server error: {m}"
    | Result(false, m, c) => s"Error {c}: {m}"
  ;
;

print(handleResult(Result(true, "Operation completed", 0)))
print(handleResult(Result(true, "Created", 201)))
print(handleResult(Result(false, "Page not found", 404)))
print(handleResult(Result(false, "Internal error", 500)))
print(handleResult(Result(false, "Unknown error", 999)))

// === 17. Generics Test ===
print("")
print("=== Generics Test ===")

// Generic struct: Stack<T>
S Stack<T>
  T[]#items

  Z push(T#item)
    items.push(item)
  ;

  i Z size()
    items.len()
  ;

  b Z isEmpty()
    items.len() == 0
  ;
;

// Stack of ints
Stack<i>#intStack = Stack<i>([])
intStack.push(1)
intStack.push(2)
intStack.push(3)
print(s"Int stack size: {intStack.size()}")

// Stack of strings
Stack<s>#strStack = Stack<s>([])
strStack.push("hello")
strStack.push("world")
print(s"String stack size: {strStack.size()}")

// Stack of Vector2 structs
Stack<Vector2>#vecStack = Stack<Vector2>([])
vecStack.push(Vector2(1.0, 2.0))
vecStack.push(Vector2(3.0, 4.0))
print(s"Vector stack size: {vecStack.size()}")

// Generic function: first<T>
<T> T Z first(T[]#arr)
  arr[0]
;

i#firstInt = first([10, 20, 30])
print(s"First int: {firstInt}")

s#firstStr = first(["a", "b", "c"])
print(s"First string: {firstStr}")

Vector2#firstVec = first([Vector2(5.0, 6.0), Vector2(7.0, 8.0)])
print(s"First vector: ({firstVec.x}, {firstVec.y})")

// Multi-parameter generics: Pair<A, B>
S Pair<A, B>
  A#first
  B#second
;

Pair<i, s>#pair1 = Pair<i, s>(42, "answer")
print(s"Pair: ({pair1.first}, {pair1.second})")

Pair<f, b>#pair2 = Pair<f, b>(3.14, true)
print(s"Pair: ({pair2.first}, {pair2.second})")

// Generic Result<T> type
S GenericResult<T>
  b#success
  T#value
  s#errorMsg
;

GenericResult<i>#okResult = GenericResult<i>(true, 100, "")
?(okResult.success)
  print(s"Result value: {okResult.value}")
;

GenericResult<s>#errResult = GenericResult<s>(false, "", "Something went wrong")
?(errResult.success)
  print(s"Success: {errResult.value}")
:
  print(s"Error: {errResult.errorMsg}")
;

print("Generics tests passed!")

// === 18. Traits Test ===
print("")
print("=== Traits Test ===")

// Basic trait declaration
ZZ Printable
  s Z toString()
;

ZZ Comparable
  i Z compareTo(Self#other)
;

// Struct implementing a single trait
S Point2D : Printable
  f#x
  f#y

  s Z toString()
    s"({x}, {y})"
  ;
;

// Struct implementing multiple traits
S Score : Printable, Comparable
  i#value
  s#label

  s Z toString()
    s"{label}: {value}"
  ;

  i Z compareTo(Score#other)
    value - other.value
  ;
;

// Trait as function parameter type (polymorphism)
Z display(Printable#item)
  print(s"Display: {item.toString()}")
;

Point2D#pt = Point2D(3.0, 4.0)
display(pt)

Score#s1 = Score(100, "Alice")
Score#s2 = Score(85, "Bob")
display(s1)
display(s2)

// Trait method call on trait-typed variable
Printable#printable = Point2D(7.0, 8.0)
print(s"Printable: {printable.toString()}")

// Comparable Self type
i#cmpResult = s1.compareTo(s2)
print(s"Compare Alice vs Bob: {cmpResult}")

// Trait with void method
ZZ Describable
  Z describe()
;

S Animal : Describable
  s#name
  s#sound

  Z describe()
    print(s"The {name} says {sound}")
  ;
;

Animal#cat = Animal("cat", "meow")
cat.describe()

print("Traits tests passed!")

// === Multi-dimensional Arrays ===
print("")
print("=== Multi-dimensional Arrays ===")

// 2D int array
i[][]~matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
