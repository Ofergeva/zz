print(s"Matrix[1][2]: {matrix[1][2]}")

// Push a row
matrix.push([10, 11, 12])
print(s"Matrix rows after push: {matrix.len()}")

// 2D string array
s[][]#words = [["hello", "world"], ["foo", "bar"]]
print(s"Words[0][1]: {words[0][1]}")
print(s"Words[1][0]: {words[1][0]}")

// 3D int array
i[][][]#cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
print(s"Cube[0][0][0]: {cube[0][0][0]}")
print(s"Cube[1][1][1]: {cube[1][1][1]}")

print("Multi-dimensional arrays passed!")

