// === JSON Array Parsing ===
print("")
print("=== JSON Array Parsing ===")
<- { parseArray, parseIntArray, parseStrArray, isArray } = std/json

J[]#items = parseArray("[{\"id\": 1}, {\"id\": 2}, {\"id\": 3}]")
print(s"Parsed J array length: {items.len()}")

i[]#nums = parseIntArray("[10, 20, 30, 40, 50]")
print(s"Parsed int array length: {nums.len()}")
print(s"First int: {nums[0]}")

s[]#strs = parseStrArray("[\"hello\", \"world\"]")
print(s"Parsed str array length: {strs.len()}")
print(s"First str: {strs[0]}")

// isArray check
<- { parse } = std/json
J#jsonObj = parse("{\"key\": \"value\"}")
J#jsonArr = parse("[1, 2, 3]")
print(s"Object isArray: {isArray(jsonObj)}")
print(s"Array isArray: {isArray(jsonArr)}")

print("JSON array parsing passed!")

// === Generic Constraints Test ===
print("")
print("=== Generic Constraints Test ===")

// Constrained generic function — only Printable types allowed
<T: Printable> s Z constDescribe(T#item)
  s"desc: {item.toString()}"
;

// Test with Point2D (implements Printable from Traits Test above)
Point2D#constPt = Point2D(5.0, 10.0)
s#cdesc = constDescribe(constPt)
print(s"Constrained describe: {cdesc}")

// Constrained generic struct
S Wrapper<T: Printable>
  T#inner

  s Z show()
    inner.toString()
  ;
;

Wrapper<Point2D>#wrp = Wrapper<Point2D>(Point2D(1.0, 2.0))
print(s"Wrapper show: {wrp.show()}")

// Mixed constrained and unconstrained type params
<T: Printable, U> s Z showWithExtra(T#item U#extra)
  s"shown: {item.toString()}"
;

s#mixed = showWithExtra(constPt, 99)
print(s"Mixed params: {mixed}")

print("Generic constraints passed!")

// === Package Imports Test ===
print("")
print("=== Package Imports Test ===")

<- { greet, shout, add } = pkg/greeting

s#pkgMsg = greet("ZZ")
print(s"Greet: {pkgMsg}")

s#pkgLoud = shout("packages")
print(s"Shout: {pkgLoud}")

i#pkgSum = add(100, 200)
print(s"Add: {pkgSum}")

print("Package imports passed!")

