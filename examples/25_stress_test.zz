// === 13. Compile-Time Verification ===
print("")
print("=== Compile-Time Features ===")

i#ctResult = ${5 * 10 + 7}
print(s"Compile-time computed: {ctResult}")

s#buildInfo = ${$date()}
print(s"Build date: {buildInfo}")

$Z i ctFib(i#n)
  ??(n)
    | 0 => 0
    | 1 => 1
    | _ => ctFib(n - 1) + ctFib(n - 2)
  ;
;

i#ctFib10 = ${ctFib(10)}
print(s"Compile-time Fibonacci(10): {ctFib10}")

