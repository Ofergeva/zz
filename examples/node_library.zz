<- {env, argv, pid, nodeVersion} = "../../lib/node/index.js"

S Person 
    s#name
    i#age
    b#isEmployed
;

Person#Mooki = Person(name = "Mooki",age = 5,isEmployed = false)
Person#Alice = Person(name = "Alice",age = 30,isEmployed = true)

print("Person Mooki: " + Mooki.name)
print(s"Person Alice: {Alice.age}")