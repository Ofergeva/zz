<- {platform, arch, type, cpus} = "../../lib/node/os.js"
<- {Path, sep} = "../../lib/node/path.js"

s#platformS = platform()
s#archS = arch()
s#typeS = type()
s~cpusS = ""
$js{ cpusS = cpus().map(c => c.model).join(", ") }
print(s"Platform: {platformS}")
print(s"Architecture: {archS}")
print(s"OS CPUs: {cpusS}")
print(s"OS Type: {typeS}")
print(s"Path Separator: {sep}")

