// Math library for ZZ

// Exported functions
->i Z add(i#a i#b)
  a + b
;

->i Z subtract(i#a i#b)
  a - b
;

->i Z multiply(i#a i#b)
  a * b
;

->f Z divide(i#a i#b)
  f(a) / f(b)
;

// Exported constant
->s#VERSION = "1.0.0"
->f#PI = 3.14159

// Private helper (not exported)
i Z square(i#x)
  x * x
;
