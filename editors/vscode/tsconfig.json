{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true
  },
  "references": [
    { "path": "./client" },
    { "path": "./server" }
  ],
  "exclude": ["node_modules", ".vscode-test"]
}
