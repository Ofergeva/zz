{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZZ",
  "scopeName": "source.zz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#interpolated-strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#modules" },
    { "include": "#control-flow" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#variables" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.double-slash.zz",
      "match": "//.*$"
    },
    "strings": {
      "name": "string.quoted.double.zz",
      "begin": "(?<!s)\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zz",
          "match": "\\\\."
        }
      ]
    },
    "interpolated-strings": {
      "name": "string.interpolated.zz",
      "begin": "s\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.zz",
          "match": "\\\\."
        },
        {
          "name": "meta.interpolation.zz",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.zz" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.zz" }
          },
          "patterns": [
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#operators" },
            {
              "name": "variable.other.zz",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zz",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.zz",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.zz",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.zz",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.zz",
          "match": "\\b_\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.print.zz",
          "match": "\\bprint\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "keyword.control.export.zz",
          "match": "->"
        },
        {
          "name": "keyword.control.import.zz",
          "match": "<-"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.loop.zz",
          "match": "@"
        },
        {
          "name": "keyword.control.conditional.zz",
          "match": "\\?(?!\\()"
        },
        {
          "name": "keyword.control.conditional.if.zz",
          "match": "\\?(?=\\()"
        },
        {
          "name": "keyword.control.conditional.elseif.zz",
          "match": ":\\?"
        },
        {
          "name": "keyword.control.conditional.else.zz",
          "match": ":(?!\\?|\\()"
        },
        {
          "name": "keyword.control.catch.zz",
          "match": ":\\("
        },
        {
          "name": "keyword.control.break.zz",
          "match": ">!"
        },
        {
          "name": "keyword.control.continue.zz",
          "match": ">>"
        },
        {
          "name": "keyword.control.end.zz",
          "match": ";"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "keyword.other.function.zz",
          "match": "\\bZ\\b"
        },
        {
          "name": "entity.name.function.zz",
          "match": "(?<=Z\\s+)[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "entity.name.function.call.zz",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.zz",
          "match": "\\b[sifb](?=\\[|#|~)"
        },
        {
          "name": "storage.modifier.immutable.zz",
          "match": "#"
        },
        {
          "name": "storage.modifier.mutable.zz",
          "match": "~"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.increment.zz",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.compound-assignment.zz",
          "match": "\\*\\*=|\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.arithmetic.zz",
          "match": "\\*\\*|[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.zz",
          "match": "==|!=|>=|<=|>|<"
        },
        {
          "name": "keyword.operator.logical.zz",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.zz",
          "match": "="
        },
        {
          "name": "keyword.operator.range.zz",
          "match": "\\.\\."
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.zz",
          "match": "(?<=[#~])[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.brackets.round.zz",
          "match": "[()]"
        },
        {
          "name": "punctuation.brackets.square.zz",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.zz",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.zz",
          "match": "\\."
        }
      ]
    }
  }
}
