{
  "name": "zz-language",
  "displayName": "ZZ Language",
  "description": "Language support for ZZ - syntax highlighting, real-time errors, autocomplete, and go-to-definition",
  "version": "0.2.0",
  "publisher": "zz-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "icon": "icon.png",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:zz"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "zz",
        "aliases": ["ZZ", "zz"],
        "extensions": [".zz"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zz",
        "scopeName": "source.zz",
        "path": "./syntaxes/zz.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "ZZ Language",
      "properties": {
        "zz.maxNumberOfProblems": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems to report per file"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run copy-compiler && tsc -b",
    "copy-compiler": "mkdir -p compiler && cp ../../dist/{lexer.js,parser.js,typechecker.js,errors.js,ast.js} compiler/ && rm -rf std && cp -r ../../std std",
    "watch": "tsc -b -w",
    "postinstall": "cd client && npm install && cd ../server && npm install"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
